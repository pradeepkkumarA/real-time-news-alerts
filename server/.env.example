PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/news-alerts

# Long random string used to sign JWTs
JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins (CORS + Socket.io)
CLIENT_URL=http://localhost:5173
# Used for links inside emails / push notifications
APP_URL=http://localhost:5173

# SMTP (leave SMTP_HOST empty to log emails to the console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="News Alerts <no-reply@example.com>"

# Optional: NewsAPI key (https://newsapi.org). RSS feeds are always used as fallback.
NEWS_API_KEY=

# Web Push VAPID keys. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Ingestion schedule (cron syntax)
FETCH_CRON=*/5 * * * *
